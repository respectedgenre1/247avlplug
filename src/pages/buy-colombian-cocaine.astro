<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="seo-title">Product | 247 AVL Plug</title>
    <meta name="description" id="seo-desc" content="">
    <meta name="robots" content="index, follow">
    <link id="seo-canonical" rel="canonical" href="">
    <meta property="og:type" content="product">
    <meta property="og:title" id="og-title" content="">
    <meta property="og:description" id="og-desc" content="">
    <meta property="og:image" id="og-image" content="">
    <meta property="og:url" id="og-url" content="">
    <meta name="twitter:card" content="summary_large_image">

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #FF9500;
            color: #1d1d1f;
            line-height: 1.6;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }
        header {
            background-color: rgba(255,255,255,0.97);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e5e5e7;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        .back-btn {
            background-color: #fff;
            border: 1.5px solid #d1d1d6;
            color: #1d1d1f;
            padding: 10px 20px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .header-title {
            font-size: 15px;
            font-weight: 600;
            color: #6e6e73;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 50%;
        }
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 28px 16px 60px;
        }
        article {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
        .card {
            background-color: #ffffff;
            border-radius: 24px;
            padding: 28px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        }
        .product-image-container {
            padding: 20px;
            background-color: #f5f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .image-wrapper {
            position: relative;
            width: 100%;
            max-width: 500px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
            background-color: #e5e5e7;
        }
        .product-image {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
            aspect-ratio: 1 / 1;
        }
        .image-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background-color: #25D366;
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            padding: 7px 16px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            box-shadow: 0 4px 12px rgba(37,211,102,0.4);
            z-index: 2;
        }
        .product-details {
            padding: 32px 28px;
        }
        .product-title {
            font-size: 34px;
            font-weight: 800;
            margin-bottom: 6px;
            line-height: 1.15;
            color: #1d1d1f;
        }
        .product-subtitle {
            font-size: 15px;
            color: #6e6e73;
            margin-bottom: 24px;
            font-weight: 500;
        }
        .product-description {
            color: #6e6e73;
            font-size: 16px;
            line-height: 1.7;
            margin-bottom: 28px;
            padding: 22px;
            background-color: #f5f5f7;
            border-radius: 16px;
            border-left: 4px solid #25D366;
        }
        .section-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #86868b;
            margin-bottom: 14px;
        }
        .buy-buttons {
            display: flex;
            gap: 12px;
            margin-top: 4px;
        }
        .contact-btn {
            flex: 1;
            padding: 18px 20px;
            border-radius: 14px;
            text-align: center;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: none;
            cursor: pointer;
        }
        .btn-whatsapp {
            background-color: #25D366;
            color: #fff;
        }
        .btn-telegram {
            background-color: #0088cc;
            color: #fff;
        }

        /* ============================================================ */
        /*  FEATURED PRODUCTS GRID                                      */
        /* ============================================================ */
        .featured-products-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 16px;
        }
        .featured-product-card {
            flex: 1 1 calc(50% - 6px);
            min-width: 130px;
            max-width: calc(50% - 6px);
            background-color: #ffffff;
            border: 1.5px solid #e5e5e7;
            border-radius: 14px;
            overflow: hidden;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            transition: all 0.25s ease;
        }
        .featured-product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border-color: #25D366;
        }
        .featured-product-card img {
            width: 100%;
            height: auto;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            display: block;
            background-color: #f0f0f2;
        }
        .featured-product-card h3 {
            font-size: 13px;
            font-weight: 700;
            color: #1d1d1f;
            padding: 12px;
            text-align: center;
            line-height: 1.3;
        }

        @media (min-width: 768px) {
            main { padding: 40px 28px 80px; }
            article { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
            .product-image-container { position: sticky; top: 80px; }
            .product-details { padding: 40px 36px; }
            .product-title { font-size: 40px; }
            .featured-product-card {
                flex: 1 1 calc(25% - 9px);
                min-width: 90px;
                max-width: calc(25% - 9px);
            }
            .featured-product-card h3 {
                font-size: 14px;
                padding: 14px;
            }
        }
        @media (min-width: 1200px) {
            main { max-width: 1280px; padding: 48px 40px 100px; }
            article { gap: 40px; }
            .product-title { font-size: 44px; }
        }
        @media (max-width: 480px) {
            .product-title { font-size: 26px; }
            .product-details { padding: 24px 20px; }
            .card { padding: 20px; border-radius: 20px; }
            .buy-buttons { flex-direction: column; }
            .contact-btn { width: 100%; }
            .featured-product-card h3 {
                font-size: 12px;
                padding: 10px;
            }
        }
    </style>
<base target="_blank">
</head>
<body>

    <header>
        <a href="/" class="back-btn">&#8592; Back to Shop</a>
        <h1 id="header-title" class="header-title"></h1>
    </header>

    <main>
        <article>
            <div class="card product-image-container">
                <div class="image-wrapper">
                    <span class="image-badge" id="img-badge">In Stock</span>
                    <img id="p-img" src="" alt="" class="product-image">
                </div>
            </div>

            <section class="card product-details">
                <h2 id="p-name" class="product-title"></h2>
                <p id="p-subtitle" class="product-subtitle"></p>

                <div class="section-label">Key Features</div>
                <div id="feature-bubbles"></div>

                <p id="p-desc" class="product-description"></p>

                <div class="section-label">Choose Your Package</div>
                <div id="pricing-tiers"></div>

                <div class="buy-buttons">
                    <a id="btn-wa" href="#" class="contact-btn btn-whatsapp" target="_blank" rel="noopener">
                        <span style="font-size:20px;">&#128172;</span> WhatsApp
                    </a>
                    <a id="btn-tg" href="#" class="contact-btn btn-telegram" target="_blank" rel="noopener">
                        <span style="font-size:20px;">&#9992;</span> Telegram
                    </a>
                </div>

                <!-- FEATURED PRODUCTS -->
                <div class="section-label" style="margin-top:32px;">You May Also Like</div>
                <div id="featured-products" class="featured-products-grid"></div>

                <!-- FOOTER POLICY LINKS -->
                <div id="footer-links"></div>
            </section>
        </article>
    </main>

    <!-- ================================================================ -->
    -->
    <!--   EDIT ONLY THIS BLOCK FOR NEW PRODUCTS                          -->
    -->
    <!--   Each section is labeled. Change the values inside quotes.      -->
    -->
    <!-- ================================================================ -->
    <script>
        const PRODUCT_CONFIG = {

            /* ========================================================= */
            /*  1. BASIC INFO                                            */
            /* ========================================================= */
            name: "Premium Research Chemical",
            subtitle: "Lab-Grade Purity | Discreet Worldwide Delivery",

            /* ========================================================= */
            /*  2. IMAGES                                                */
            /* ========================================================= */
            imageSrc: "/images/product.jpg",
            imageAlt: "Premium research chemical product",
            imageBadge: "In Stock",

            /* ========================================================= */
            /*  3. SEO & META                                            */
            /* ========================================================= */
            seoTitle: "Buy Premium Research Chemical | 247 AVL Plug",
            seoDescription: "Premium research chemical with lab-grade purity. Discreet packaging, worldwide delivery. Order now at 247 AVL Plug!",
            urlSlug: "premium-research-chemical.html",

            /* ========================================================= */
            /*  4. PRICING TIERS                                         */
            /* ========================================================= */
            pricingTiers: [
                { label: "1 Gram",    price: "$49.99",              badge: "" },
                { label: "5 Grams",   price: "$199.99",            badge: "Save 20%" },
                { label: "10 Grams",  price: "$349.99",            badge: "Best Value" },
                { label: "25 Grams",  price: "$749.99",            badge: "Bulk" },
                { label: "50+ Grams", price: "Contact for Quote",  badge: "Wholesale" }
            ],
            defaultTierIndex: 0,

            /* ========================================================= */
            /*  5. DESCRIPTION                                           */
            /* ========================================================= */
            description: "Premium research chemical sourced for maximum purity and consistency. Every batch is lab-tested, vacuum-sealed in discreet packaging, and shipped to any address worldwide with full tracking.",

            /* ========================================================= */
            /*  6. FEATURES (3 items max)                                */
            /*     Emojis: 💎 = High Purity                              */
            /*             📦 = Discreet Packaging                       */
            /*             🚚 = Any Address Delivery                     */
            /* ========================================================= */
            features: [
                "High Purity",
                "Discreet Packaging",
                "Any Address Delivery"
            ],
            featureEmojis: ["&#128142;", "&#128230;", "&#128666;"],

            /* ========================================================= */
            /*  7. CONTACT — EDIT THESE FOR YOUR ACCOUNTS                */
            /* ========================================================= */
            // WhatsApp: digits only, NO plus (+) and NO spaces
            whatsappNumber: "13254365583",

            // Telegram: username WITHOUT the @ symbol
            telegramHandle: "datplugg",

            /* ========================================================= */
            /*  8. FEATURED PRODUCTS                                     */
            /*     4 products shown below contact buttons                */
            /*     Edit name, image path, and link URL for each          */
            /* ========================================================= */
            featuredProducts: [
                { name: "Research Chem A", image: "/images/chem-a.jpg",  url: "/products/chem-a.html" },
                { name: "Research Chem B", image: "/images/chem-b.jpg",  url: "/products/chem-b.html" },
                { name: "Research Chem C", image: "/images/chem-c.jpg",  url: "/products/chem-c.html" },
                { name: "Research Chem D", image: "/images/chem-d.jpg",  url: "/products/chem-d.html" }
            ],

            /* ========================================================= */
            /*  9. FOOTER POLICY LINKS                                   */
            /*     Edit the text and URLs for each policy link           */
            /* ========================================================= */
            footerLinks: [
                { text: "Privacy Policy",                 url: "/privacy-policy.html" },
                { text: "Payment and Refund Policy",      url: "/payment-refund-policy.html" },
                { text: "Terms and Conditions",           url: "/terms-and-conditions.html" },
                { text: "Shipping and Delivery Policies", url: "/shipping-delivery-policy.html" }
            ],

            /* ========================================================= */
            /*  10. THEME COLORS                                         */
            /* ========================================================= */
            themeColor: "#25D366",
            backgroundColor: "#FF9500"
        };

        /* ================================================================ */
        /*  ENGINE — DO NOT EDIT BELOW THIS LINE                            */
        /* ================================================================ */
        document.addEventListener('DOMContentLoaded', function() {
            var p = PRODUCT_CONFIG;
            var baseUrl = "https://247avlplug.com";
            var productUrl = baseUrl + "/products/" + p.urlSlug;
            var imageUrl = p.imageSrc.startsWith('http') ? p.imageSrc : baseUrl + p.imageSrc;

            document.body.style.backgroundColor = p.backgroundColor;

            // SEO
            document.title = p.seoTitle;
            document.getElementById('seo-desc').content = p.seoDescription;
            document.getElementById('seo-canonical').href = productUrl;
            document.getElementById('og-title').content = p.seoTitle;
            document.getElementById('og-desc').content = p.seoDescription;
            document.getElementById('og-image').content = imageUrl;
            document.getElementById('og-url').content = productUrl;

            // Content
            document.getElementById('header-title').textContent = p.name;
            document.getElementById('p-name').textContent = p.name;
            document.getElementById('p-subtitle').textContent = p.subtitle;
            document.getElementById('p-desc').textContent = p.description;

            var imgEl = document.getElementById('p-img');
            imgEl.src = imageUrl;
            imgEl.alt = p.imageAlt;

            var badgeEl = document.getElementById('img-badge');
            if (p.imageBadge && p.imageBadge.trim() !== "") {
                badgeEl.textContent = p.imageBadge;
                badgeEl.style.display = "inline-block";
            } else {
                badgeEl.style.display = "none";
            }

            /* ========================================================= */
            /*  FEATURE CARDS                                            */
            /* ========================================================= */
            var featuresContainer = document.getElementById('feature-bubbles');
            featuresContainer.innerHTML = '';
            featuresContainer.style.display = 'flex';
            featuresContainer.style.flexWrap = 'wrap';
            featuresContainer.style.gap = '12px';
            featuresContainer.style.marginBottom = '28px';

            var emojis = p.featureEmojis || ["&#10003;", "&#10003;", "&#10003;"];

            if (p.features && p.features.length > 0) {
                for (var i = 0; i < p.features.length; i++) {
                    var card = document.createElement('div');
                    card.style.backgroundColor = '#ffffff';
                    card.style.border = '1.5px solid #e5e5e7';
                    card.style.borderTop = '4px solid #25D366';
                    card.style.borderRadius = '14px';
                    card.style.padding = '18px 16px';
                    card.style.flex = '1 1 140px';
                    card.style.minWidth = '140px';
                    card.style.textAlign = 'center';
                    card.style.boxShadow = '0 2px 8px rgba(0,0,0,0.06)';
                    card.style.transition = 'all 0.25s ease';
                    card.style.cursor = 'default';

                    card.innerHTML =
                        '<div style="font-size:28px;margin-bottom:8px;">' + emojis[i] + '</div>' +
                        '<div style="font-size:13px;font-weight:700;color:#1d1d1f;line-height:1.4;">' + p.features[i] + '</div>';

                    featuresContainer.appendChild(card);
                }
            }

            /* ========================================================= */
            /*  PRICING TIERS                                            */
            /* ========================================================= */
            var tiersContainer = document.getElementById('pricing-tiers');
            tiersContainer.innerHTML = '';
            tiersContainer.style.display = 'flex';
            tiersContainer.style.flexDirection = 'column';
            tiersContainer.style.gap = '10px';
            tiersContainer.style.marginBottom = '28px';

            var currentTier = p.pricingTiers[p.defaultTierIndex];

            for (var i = 0; i < p.pricingTiers.length; i++) {
                (function(tier, index) {
                    var row = document.createElement('div');
                    var isSelected = (index === p.defaultTierIndex);

                    row.style.backgroundColor = isSelected ? '#e8f8ee' : '#ffffff';
                    row.style.border = isSelected ? '2px solid #25D366' : '2px solid #d1d1d6';
                    row.style.borderLeft = isSelected ? '5px solid #25D366' : '2px solid #d1d1d6';
                    row.style.borderRadius = '12px';
                    row.style.padding = '16px 18px';
                    row.style.cursor = 'pointer';
                    row.style.display = 'flex';
                    row.style.alignItems = 'center';
                    row.style.justifyContent = 'space-between';
                    row.style.gap = '12px';
                    row.style.boxShadow = isSelected ? '0 4px 12px rgba(37,211,102,0.15)' : '0 1px 4px rgba(0,0,0,0.04)';
                    row.style.transition = 'all 0.2s ease';

                    var radioColor = isSelected ? '#25D366' : '#d1d1d6';
                    var radioInner = isSelected ? '<div style="width:10px;height:10px;background:#fff;border-radius:50%;"></div>' : '';

                    var badgeHtml = '';
                    if (tier.badge && tier.badge.trim() !== '') {
                        badgeHtml = '<span style="font-size:11px;background:#25D366;color:#fff;padding:3px 10px;border-radius:50px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;">' + tier.badge + '</span>';
                    }

                    row.innerHTML =
                        '<div style="display:flex;align-items:center;gap:12px;flex:1;">' +
                            '<div style="width:22px;height:22px;border-radius:50%;border:3px solid ' + radioColor + ';background:' + radioColor + ';display:flex;align-items:center;justify-content:center;flex-shrink:0;">' + radioInner + '</div>' +
                            '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
                                '<span style="font-weight:700;font-size:15px;color:#1d1d1f;white-space:nowrap;">' + tier.label + '</span>' +
                                badgeHtml +
                            '</div>' +
                        '</div>' +
                        '<span style="font-weight:800;font-size:17px;color:#1faa52;white-space:nowrap;flex-shrink:0;">' + tier.price + '</span>';

                    row.addEventListener('click', function() {
                        var allRows = tiersContainer.children;
                        for (var j = 0; j < allRows.length; j++) {
                            var r = allRows[j];
                            r.style.backgroundColor = '#ffffff';
                            r.style.border = '2px solid #d1d1d6';
                            r.style.borderLeft = '2px solid #d1d1d6';
                            r.style.boxShadow = '0 1px 4px rgba(0,0,0,0.04)';
                            var radio = r.querySelector('div > div');
                            if (radio) {
                                radio.style.borderColor = '#d1d1d6';
                                radio.style.background = '#d1d1d6';
                                radio.innerHTML = '';
                            }
                        }

                        row.style.backgroundColor = '#e8f8ee';
                        row.style.border = '2px solid #25D366';
                        row.style.borderLeft = '5px solid #25D366';
                        row.style.boxShadow = '0 4px 12px rgba(37,211,102,0.15)';
                        var activeRadio = row.querySelector('div > div');
                        if (activeRadio) {
                            activeRadio.style.borderColor = '#25D366';
                            activeRadio.style.background = '#25D366';
                            activeRadio.innerHTML = '<div style="width:10px;height:10px;background:#fff;border-radius:50%;"></div>';
                        }

                        updateLinks(tier);
                    });

                    tiersContainer.appendChild(row);
                })(p.pricingTiers[i], i);
            }

            /* ========================================================= */
            /*  FEATURED PRODUCTS                                        */
            /* ========================================================= */
            var featuredContainer = document.getElementById('featured-products');
            featuredContainer.innerHTML = '';

            if (p.featuredProducts && p.featuredProducts.length > 0) {
                for (var f = 0; f < p.featuredProducts.length; f++) {
                    var fp = p.featuredProducts[f];
                    var fpImage = fp.image.startsWith('http') ? fp.image : baseUrl + fp.image;

                    var link = document.createElement('a');
                    link.href = fp.url;
                    link.className = 'featured-product-card';

                    link.innerHTML =
                        '<img src="' + fpImage + '" alt="' + fp.name + '" loading="lazy">' +
                        '<h3>' + fp.name + '</h3>';

                    featuredContainer.appendChild(link);
                }
            }

            /* ========================================================= */
            /*  FOOTER POLICY LINKS                                      */
            /* ========================================================= */
            var footerContainer = document.getElementById('footer-links');
            footerContainer.innerHTML = '';
            footerContainer.style.marginTop = '28px';
            footerContainer.style.paddingTop = '22px';
            footerContainer.style.borderTop = '1px solid #e5e5e7';
            footerContainer.style.display = 'flex';
            footerContainer.style.flexWrap = 'wrap';
            footerContainer.style.justifyContent = 'center';
            footerContainer.style.gap = '8px 20px';

            if (p.footerLinks && p.footerLinks.length > 0) {
                for (var k = 0; k < p.footerLinks.length; k++) {
                    var link = document.createElement('a');
                    link.href = p.footerLinks[k].url;
                    link.textContent = p.footerLinks[k].text;
                    link.style.color = '#86868b';
                    link.style.fontSize = '12px';
                    link.style.fontWeight = '600';
                    link.style.textDecoration = 'none';
                    link.style.transition = 'color 0.2s ease';
                    link.style.whiteSpace = 'nowrap';

                    link.addEventListener('mouseenter', function() {
                        this.style.color = '#25D366';
                    });
                    link.addEventListener('mouseleave', function() {
                        this.style.color = '#86868b';
                    });

                    footerContainer.appendChild(link);
                }
            }

            /* ========================================================= */
            /*  CONTACT LINKS                                            */
            /* ========================================================= */
            function updateLinks(selectedTier) {
                var waMessage = encodeURIComponent(
                    'Hi! I want to buy the ' + p.name + ' (' + selectedTier.label + ' - ' + selectedTier.price + ') from 247avlplug.com'
                );
                document.getElementById('btn-wa').href = 'https://wa.me/' + p.whatsappNumber + '?text=' + waMessage;

                var tgMessage = encodeURIComponent(
                    'Hi! I want to buy the ' + p.name + ' (' + selectedTier.label + ' - ' + selectedTier.price + ') from 247avlplug.com'
                );
                document.getElementById('btn-tg').href = 'https://t.me/' + p.telegramHandle + '?text=' + tgMessage;
            }

            updateLinks(currentTier);
        });
    </script>
</body>
</html>
