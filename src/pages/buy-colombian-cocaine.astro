<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SEO TAGS (Auto-updated by script — no need to touch)          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <title id="seo-title">Product | 247 AVL Plug</title>
    <meta name="description" id="seo-desc" content="">
    <meta name="robots" content="index, follow">
    <link id="seo-canonical" rel="canonical" href="">
    <meta property="og:type" content="product">
    <meta property="og:title" id="og-title" content="">
    <meta property="og:description" id="og-desc" content="">
    <meta property="og:image" id="og-image" content="">
    <meta property="og:url" id="og-url" content="">
    <meta name="twitter:card" content="summary_large_image">

    <style>
        /* ═══════════════════════════════════════════════════════════════ */
        /*  DESIGN TOKENS  —  Change these to re-theme the entire page    */
        /* ═══════════════════════════════════════════════════════════════ */
        :root {
            --bg-page: #FF9500;               /* Page background */
            --bg-card: #ffffff;               /* Card background */
            --accent: #25D366;                /* WhatsApp green / primary accent */
            --accent-dark: #1faa52;           /* Hover state */
            --accent-glow: rgba(37, 211, 102, 0.25);
            --text-primary: #1d1d1f;
            --text-secondary: #6e6e73;
            --text-muted: #86868b;
            --border: #e5e5e7;
            --border-light: #f0f0f2;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.10);
            --shadow-lg: 0 16px 48px rgba(0,0,0,0.14);
            --shadow-accent: 0 8px 24px rgba(37,211,102,0.30);
            --radius-sm: 12px;
            --radius-md: 18px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  BASE STYLES                                                   */
        /* ═══════════════════════════════════════════════════════════════ */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  HEADER                                                        */
        /* ═══════════════════════════════════════════════════════════════ */
        header {
            background: rgba(255,255,255,0.96);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-light);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .back-btn {
            background: var(--bg-card);
            border: 1.5px solid var(--border);
            color: var(--text-primary);
            padding: 10px 20px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
            box-shadow: var(--shadow-sm);
        }
        .back-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .header-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-secondary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  MAIN LAYOUT                                                   */
        /* ═══════════════════════════════════════════════════════════════ */
        main {
            max-width: 1240px;
            margin: 0 auto;
            padding: 32px 20px 80px;
        }

        article {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  CARDS                                                         */
        /* ═══════════════════════════════════════════════════════════════ */
        .card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 32px;
            box-shadow: var(--shadow-lg);
            transition: var(--transition);
        }
        .card:hover {
            box-shadow: 0 20px 60px rgba(0,0,0,0.16);
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  PRODUCT IMAGE                                                 */
        /* ═══════════════════════════════════════════════════════════════ */
        .product-image-container {
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(145deg, #fafafa 0%, #f0f0f2 100%);
            overflow: hidden;
        }

        .image-wrapper {
            position: relative;
            width: 100%;
            max-width: 520px;
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            transition: var(--transition);
        }
        .image-wrapper:hover {
            transform: scale(1.02);
            box-shadow: var(--shadow-lg);
        }

        .product-image {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
            aspect-ratio: 1 / 1;
        }

        .image-badge {
            position: absolute;
            top: 16px;
            left: 16px;
            background: var(--accent);
            color: white;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 12px rgba(37,211,102,0.4);
            animation: pulse-badge 2s infinite;
        }

        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  PRODUCT DETAILS                                               */
        /* ═══════════════════════════════════════════════════════════════ */
        .product-details { padding: 36px 32px; }

        .product-title {
            font-size: 36px;
            font-weight: 800;
            margin-bottom: 8px;
            line-height: 1.15;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--text-primary) 0%, #434344 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .product-subtitle {
            font-size: 15px;
            color: var(--text-secondary);
            margin-bottom: 24px;
            font-weight: 500;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  FEATURE BUBBLES  —  THE EXCITING PART                         */
        /* ═══════════════════════════════════════════════════════════════ */
        .features-section {
            margin-bottom: 28px;
        }

        .section-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            margin-bottom: 14px;
        }

        .feature-bubbles {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .feature-bubble {
            position: relative;
            background: linear-gradient(135deg, #ffffff 0%, #f8fff9 50%, #e8f8ee 100%);
            border: 2px solid var(--accent);
            border-radius: 50px;
            padding: 10px 18px 10px 14px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 3px 10px var(--accent-glow);
            transition: var(--transition);
            cursor: default;
            overflow: hidden;
            white-space: nowrap;
        }

        .feature-bubble::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            transition: left 0.6s ease;
        }

        .feature-bubble:hover::before {
            left: 100%;
        }

        .feature-bubble:hover {
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
            color: white;
            transform: translateY(-3px) scale(1.03);
            box-shadow: var(--shadow-accent);
            border-color: var(--accent-dark);
        }

        .feature-bubble-icon {
            width: 26px;
            height: 26px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 900;
            flex-shrink: 0;
            transition: var(--transition);
            box-shadow: 0 2px 6px rgba(37,211,102,0.3);
        }

        .feature-bubble:hover .feature-bubble-icon {
            background: rgba(255,255,255,0.2);
            color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  DESCRIPTION                                                   */
        /* ═══════════════════════════════════════════════════════════════ */
        .product-description {
            color: var(--text-secondary);
            font-size: 16px;
            line-height: 1.75;
            margin-bottom: 32px;
            padding: 24px;
            background: linear-gradient(135deg, #fafafa 0%, #f5f5f7 100%);
            border-radius: var(--radius-md);
            border-left: 4px solid var(--accent);
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  PRICING TIERS  —  CARD STYLE                                  */
        /* ═══════════════════════════════════════════════════════════════ */
        .pricing-section { margin-bottom: 32px; }

        .pricing-tiers {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .tier-option {
            position: relative;
            background: var(--bg-card);
            border: 2.5px solid var(--border);
            border-radius: var(--radius-md);
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
            gap: 16px;
            overflow: hidden;
        }

        .tier-option::after {
            content: '';
            position: absolute;
            right: 20px;
            width: 22px;
            height: 22px;
            border: 2.5px solid var(--border);
            border-radius: 50%;
            transition: var(--transition);
            flex-shrink: 0;
        }

        .tier-option:hover {
            border-color: var(--accent);
            background: linear-gradient(135deg, #ffffff 0%, #f0fff4 100%);
            transform: translateX(4px);
            box-shadow: var(--shadow-md);
        }

        .tier-option.selected {
            border-color: var(--accent);
            background: linear-gradient(135deg, #e8f8ee 0%, #d4f5dd 100%);
            box-shadow: var(--shadow-accent);
        }

        .tier-option.selected::after {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: inset 0 0 0 4px white;
        }

        .tier-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            flex: 1;
        }

        .tier-label {
            font-weight: 700;
            font-size: 16px;
            color: var(--text-primary);
        }

        .tier-badge {
            font-size: 11px;
            background: var(--accent);
            color: white;
            padding: 4px 12px;
            border-radius: 50px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(37,211,102,0.3);
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-2px); }
        }

        .tier-price {
            font-weight: 800;
            font-size: 18px;
            color: var(--accent-dark);
            flex-shrink: 0;
            margin-right: 36px;
        }

        .tier-option.selected .tier-price {
            color: #1a8c42;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  CONTACT BUTTONS                                               */
        /* ═══════════════════════════════════════════════════════════════ */
        .buy-buttons {
            display: flex;
            gap: 14px;
            margin-top: 8px;
        }

        .contact-btn {
            flex: 1;
            padding: 18px 24px;
            border-radius: var(--radius-md);
            text-align: center;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .contact-btn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s ease;
        }

        .contact-btn:hover::before {
            left: 100%;
        }

        .contact-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .btn-whatsapp {
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%);
            color: white;
            box-shadow: 0 6px 20px rgba(37,211,102,0.35);
        }
        .btn-whatsapp:hover {
            box-shadow: 0 10px 30px rgba(37,211,102,0.45);
        }

        .btn-email {
            background: var(--bg-card);
            color: var(--text-primary);
            border: 2.5px solid var(--border);
            box-shadow: var(--shadow-sm);
        }
        .btn-email:hover {
            border-color: var(--accent);
            color: var(--accent);
            box-shadow: var(--shadow-md);
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  TRUST BADGES (Bottom of details card)                         */
        /* ═══════════════════════════════════════════════════════════════ */
        .trust-badges {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 28px;
            padding-top: 24px;
            border-top: 1px solid var(--border-light);
            flex-wrap: wrap;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .trust-icon {
            font-size: 16px;
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  DESKTOP LAYOUT                                                */
        /* ═══════════════════════════════════════════════════════════════ */
        @media (min-width: 768px) {
            main { padding: 48px 32px 80px; }
            article {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 36px;
                align-items: start;
            }
            .product-image-container { position: sticky; top: 90px; }
            .product-details { padding: 44px 40px; }
            .product-title { font-size: 42px; }
            .feature-bubble { font-size: 14px; padding: 12px 20px 12px 16px; }
        }

        @media (min-width: 1200px) {
            main { max-width: 1280px; padding: 56px 40px 100px; }
            article { gap: 48px; }
            .product-title { font-size: 48px; }
        }

        /* Mobile adjustments */
        @media (max-width: 480px) {
            .product-title { font-size: 28px; }
            .product-details { padding: 28px 22px; }
            .card { padding: 20px; border-radius: var(--radius-md); }
            .tier-option { padding: 14px 16px; }
            .tier-price { font-size: 15px; margin-right: 28px; }
            .tier-option::after { right: 14px; width: 18px; height: 18px; }
            .buy-buttons { flex-direction: column; }
            .contact-btn { width: 100%; }
            .feature-bubble { font-size: 12px; padding: 8px 14px 8px 10px; }
        }

        /* ═══════════════════════════════════════════════════════════════ */
        /*  ENTRANCE ANIMATIONS                                           */
        /* ═══════════════════════════════════════════════════════════════ */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card {
            animation: slideUp 0.6s ease-out forwards;
        }

        .product-details {
            animation-delay: 0.15s;
        }

        .feature-bubble {
            opacity: 0;
            animation: slideUp 0.4s ease-out forwards;
        }

        .tier-option {
            opacity: 0;
            animation: slideUp 0.4s ease-out forwards;
        }
    </style>
<base target="_blank">
</head>
<body>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HEADER                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <header>
        <a href="/" class="back-btn">&#8592; Back to Shop</a>
        <h1 id="header-title" class="header-title"></h1>
    </header>

    <main>
        <article>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- IMAGE CARD                                                  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <div class="card product-image-container">
                <div class="image-wrapper">
                    <span class="image-badge">In Stock</span>
                    <img id="p-img" src="" alt="" class="product-image">
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- DETAILS CARD                                                -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <section class="card product-details">
                <h2 id="p-name" class="product-title"></h2>
                <p id="p-subtitle" class="product-subtitle"></p>

                <!-- FEATURE BUBBLES -->
                <div class="features-section">
                    <div class="section-label">Key Features</div>
                    <div id="feature-bubbles" class="feature-bubbles"></div>
                </div>

                <!-- DESCRIPTION -->
                <p id="p-desc" class="product-description"></p>

                <!-- PRICING TIERS -->
                <div class="pricing-section">
                    <div class="section-label">Choose Your Package</div>
                    <div id="pricing-tiers" class="pricing-tiers"></div>
                </div>

                <!-- CONTACT BUTTONS -->
                <div class="buy-buttons">
                    <a id="btn-wa" href="#" class="contact-btn btn-whatsapp" target="_blank" rel="noopener">
                        <span style="font-size:20px;">&#128172;</span> Order on WhatsApp
                    </a>
                    <a id="btn-email" href="#" class="contact-btn btn-email">
                        <span style="font-size:20px;">&#9993;</span> Email Inquiry
                    </a>
                </div>

                <!-- TRUST BADGES -->
                <div class="trust-badges">
                    <div class="trust-item"><span class="trust-icon">&#128666;</span> Fast Shipping</div>
                    <div class="trust-item"><span class="trust-icon">&#128274;</span> Secure Payment</div>
                    <div class="trust-item"><span class="trust-icon">&#9989;</span> Quality Guaranteed</div>
                </div>
            </section>
        </article>
    </main>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- ═══════════════  EDIT ONLY BELOW FOR NEW PRODUCTS  ══════════════ -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <script>
        /* ═══════════════════════════════════════════════════════════════ */
        /*  PRODUCT CONFIGURATION  —  EDIT THESE VALUES FOR EACH PRODUCT   */
        /* ═══════════════════════════════════════════════════════════════ */
        const PRODUCT_CONFIG = {

            // ─── 1. BASIC INFO ───────────────────────────────────────────
            name: "Premium GPS Tracker",
            subtitle: "Real-Time Vehicle Security & Fleet Monitoring",

            // ─── 2. IMAGES ───────────────────────────────────────────────
            // Upload image to your repo's /images/ folder, or use full URL
            imageSrc: "/images/gps-tracker.jpg", 
            imageAlt: "Premium compact GPS tracker for vehicles",
            imageBadge: "In Stock",  // Set to "" to hide badge

            // ─── 3. SEO & META ───────────────────────────────────────────
            seoTitle: "Buy Premium GPS Tracker Online | 247 AVL Plug",
            seoDescription: "Buy Premium GPS Tracker. Real-time tracking, long battery life. Choose from single units or wholesale packs. Fast shipping at 247 AVL Plug!",
            urlSlug: "premium-gps-tracker.html",  // Must match filename

            // ─── 4. PRICING TIERS ────────────────────────────────────────
            // Up to 5 options. Use badge for "Best Value", "Save 10%", etc.
            // Set badge to "" if not needed.
            pricingTiers: [
                { label: "Single Unit",     price: "$49.99",              badge: "" },
                { label: "5-Pack",          price: "$224.99",            badge: "Save 10%" },
                { label: "10-Pack",         price: "$399.99",            badge: "Best Value" },
                { label: "Wholesale (50+)", price: "Contact for Quote",  badge: "Bulk" },
                { label: "Custom Bundle",   price: "Contact for Quote",  badge: "" }
            ],
            defaultTierIndex: 0,  // Which option is pre-selected (0 = first)

            // ─── 5. DESCRIPTION & FEATURES ───────────────────────────────
            description: "Keep your vehicle secure with our Premium GPS Tracker. Features real-time location updates, geofencing alerts, and a 30-day battery life. Perfect for personal cars, fleets, and motorcycles.",

            // Features appear as green bubbles. Add/remove as needed.
            features: [
                "Real-time live tracking",
                "30-day battery life",
                "Geofencing alerts",
                "Plug-and-play install",
                "Waterproof design"
            ],

            // ─── 6. CONTACT & BRANDING ───────────────────────────────────
            whatsappNumber: "1234567890",   // Country code + number, NO '+' or spaces
            email: "sales@247avlplug.com",

            // ─── 7. THEME COLORS ─────────────────────────────────────────
            // Change these to re-theme the entire page instantly
            themeColor: "#25D366",          // Accent (buttons, badges, bubbles)
            backgroundColor: "#FF9500"      // Page background
        };

        /* ═══════════════════════════════════════════════════════════════ */
        /*  ENGINE — DO NOT EDIT BELOW THIS LINE                           */
        /* ═══════════════════════════════════════════════════════════════ */
        document.addEventListener('DOMContentLoaded', function() {
            var p = PRODUCT_CONFIG;
            var baseUrl = "https://247avlplug.com";
            var productUrl = baseUrl + "/products/" + p.urlSlug;
            var imageUrl = p.imageSrc.startsWith('http') ? p.imageSrc : baseUrl + p.imageSrc;

            // Apply dynamic colors
            document.documentElement.style.setProperty('--accent', p.themeColor);
            document.documentElement.style.setProperty('--accent-dark', adjustColor(p.themeColor, -20));
            document.documentElement.style.setProperty('--accent-glow', p.themeColor + '40');
            document.body.style.backgroundColor = p.backgroundColor;

            // Helper: darken/lighten hex color
            function adjustColor(hex, amt) {
                var usePound = false;
                if (hex[0] == "#") { hex = hex.slice(1); usePound = true; }
                var num = parseInt(hex, 16);
                var r = (num >> 16) + amt;
                var g = ((num >> 8) & 0x00FF) + amt;
                var b = (num & 0x00FF) + amt;
                if (r > 255) r = 255; else if (r < 0) r = 0;
                if (g > 255) g = 255; else if (g < 0) g = 0;
                if (b > 255) b = 255; else if (b < 0) b = 0;
                return (usePound ? "#" : "") + (g | (b << 8) | (r << 16)).toString(16).padStart(6, '0');
            }

            // 1. SEO Tags
            document.title = p.seoTitle;
            document.getElementById('seo-desc').content = p.seoDescription;
            document.getElementById('seo-canonical').href = productUrl;
            document.getElementById('og-title').content = p.seoTitle;
            document.getElementById('og-desc').content = p.seoDescription;
            document.getElementById('og-image').content = imageUrl;
            document.getElementById('og-url').content = productUrl;

            // 2. Page Content
            document.getElementById('header-title').textContent = p.name;
            document.getElementById('p-name').textContent = p.name;
            document.getElementById('p-subtitle').textContent = p.subtitle;
            document.getElementById('p-desc').textContent = p.description;

            var imgEl = document.getElementById('p-img');
            imgEl.src = imageUrl;
            imgEl.alt = p.imageAlt;

            var badgeEl = document.querySelector('.image-badge');
            if (p.imageBadge) {
                badgeEl.textContent = p.imageBadge;
                badgeEl.style.display = 'block';
            } else {
                badgeEl.style.display = 'none';
            }

            // 3. Feature Bubbles with staggered animation
            var featuresContainer = document.getElementById('feature-bubbles');
            featuresContainer.innerHTML = '';
            for (var i = 0; i < p.features.length; i++) {
                var bubble = document.createElement('div');
                bubble.className = 'feature-bubble';
                bubble.style.animationDelay = (0.3 + i * 0.08) + 's';
                bubble.innerHTML = '<span class="feature-bubble-icon">&#10003;</span><span>' + p.features[i] + '</span>';
                featuresContainer.appendChild(bubble);
            }

            // 4. Pricing Tiers with staggered animation
            var tiersContainer = document.getElementById('pricing-tiers');
            tiersContainer.innerHTML = '';
            var currentTier = p.pricingTiers[p.defaultTierIndex];

            for (var i = 0; i < p.pricingTiers.length; i++) {
                (function(tier, index) {
                    var div = document.createElement('div');
                    div.className = 'tier-option' + (index === p.defaultTierIndex ? ' selected' : '');
                    div.style.animationDelay = (0.5 + index * 0.1) + 's';

                    var badgeHtml = tier.badge ? '<span class="tier-badge">' + tier.badge + '</span>' : '';

                    div.innerHTML = 
                        '<div class="tier-left">' +
                            '<span class="tier-label">' + tier.label + '</span>' +
                            badgeHtml +
                        '</div>' +
                        '<span class="tier-price">' + tier.price + '</span>';

                    div.addEventListener('click', function() {
                        var allTiers = document.querySelectorAll('.tier-option');
                        for (var j = 0; j < allTiers.length; j++) { 
                            allTiers[j].classList.remove('selected'); 
                        }
                        div.classList.add('selected');
                        updateLinks(tier);
                    });

                    tiersContainer.appendChild(div);
                })(p.pricingTiers[i], i);
            }

            // 5. Contact Links
            function updateLinks(selectedTier) {
                var waMessage = encodeURIComponent(
                    'Hi! I want to buy the ' + p.name + ' (' + selectedTier.label + ' - ' + selectedTier.price + ') from 247avlplug.com'
                );
                document.getElementById('btn-wa').href = 'https://wa.me/' + p.whatsAppNumber + '?text=' + waMessage;

                var emailSubject = encodeURIComponent('Inquiry: ' + p.name + ' (' + selectedTier.label + ')');
                var emailBody = encodeURIComponent(
                    'Hi, I would like to purchase the ' + p.name + ' - ' + selectedTier.label + ' at ' + selectedTier.price + ' from your store.'
                );
                document.getElementById('btn-email').href = 'mailto:' + p.email + '?subject=' + emailSubject + '&body=' + emailBody;
            }

            // Initialize
            updateLinks(currentTier);
        });
    </script>
</body>
</html>
