            padding: 3rem 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
        }

        .section-header h2 {
            font-size: clamp(1.4rem, 4vw, 2rem);
            font-weight: 800;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, var(--text-primary), var(--accent-orange-bright));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-header p {
            color: var(--text-secondary);
            font-size: 0.92rem;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .video-frame {
            composes: glass-card;
            padding: 1rem;
            border-radius: var(--radius-lg);
        }

        .video-frame:hover {
            border-color: var(--border-orange);
            box-shadow: var(--shadow-orange-lg);
            transform: translateY(-4px);
        }

        .video-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border-subtle);
        }

        [data-theme="light"] .video-container {
            background: rgba(0, 0, 0, 0.08);
        }

        .video-container iframe,
        .video-container video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
            object-fit: cover;
            border-radius: var(--radius-md);
        }

        /* Video controls styling */
        .video-container video::-webkit-media-controls-panel {
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        }

        [data-theme="light"] .video-container video::-webkit-media-controls-panel {
            background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
        }

        .video-caption {
            padding: 1rem 0.5rem 0.25rem;
            text-align: center;
            font-weight: 700;
            color: var(--text-secondary);
            font-size: 0.88rem;
            letter-spacing: 0.01em;
        }

        /* ─── YOU MAY ALSO LIKE SECTION ─── */
        .related-section {
            padding: 3rem 0;
            border-top: 1px solid var(--border-subtle);
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        @media (max-width: 640px) {
            .related-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.875rem;
            }
        }

        @media (max-width: 360px) {
            .related-grid {
                grid-template-columns: 1fr;
            }
        }

        .related-card {
            composes: glass-card;
            overflow: hidden;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            border-radius: var(--radius-md);
            text-align: center;
        }

        .related-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 107, 0, 0.05), transparent 60%);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 1;
        }

        .related-card:hover::before {
            opacity: 1;
        }

        .related-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-orange-strong);
            box-shadow: var(--shadow-orange-lg);
        }

        .related-card:active {
            transform: translateY(-2px) scale(0.98);
        }

        .related-image-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 10;
            overflow: hidden;
            background: linear-gradient(135deg, rgba(20,20,20,0.8), rgba(30,30,30,0.6));
        }

        [data-theme="light"] .related-image-wrap {
            background: linear-gradient(135deg, rgba(240,240,240,0.8), rgba(230,230,230,0.6));
        }

        .related-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .related-card:hover .related-image {
            transform: scale(1.08);
        }

        .related-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 1rem;
            opacity: 0;
            transition: opacity 0.35s ease;
            z-index: 2;
        }

        .related-card:hover .related-overlay {
            opacity: 1;
        }

        .explore-btn {
            background: linear-gradient(135deg, var(--accent-orange), var(--accent-orange-light));
            color: #fff;
            padding: 0.55rem 1.5rem;
            border-radius: 100px;
            font-weight: 800;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            box-shadow: 0 4px 16px rgba(255, 107, 0, 0.35);
            transform: translateY(10px);
            transition: var(--transition-bounce);
        }

        .related-card:hover .explore-btn {
            transform: translateY(0);
        }

        .related-info {
            padding: 1.25rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            z-index: 2;
        }

        .related-name {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 0.375rem;
            transition: color 0.3s ease;
        }

        .related-card:hover .related-name {
            color: var(--accent-orange-bright);
        }

        .related-desc {
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* ─── ACCORDION SECTION ─── */
        .accordion-section {
            padding: 3rem 0 5rem;
        }

        .accordion-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .accordion-item {
            composes: glass-card;
            margin-bottom: 0.875rem;
            overflow: hidden;
            border-radius: var(--radius-md);
        }

        .accordion-item:hover {
            border-color: var(--border-orange);
        }

        .accordion-item.active {
            border-color: var(--border-orange-strong);
            box-shadow: var(--shadow-orange);
        }

        .accordion-trigger {
            width: 100%;
            padding: 1.25rem 1.5rem;
            background: none;
            border: none;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 700;
            text-align: left;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: color 0.3s ease;
            letter-spacing: 0.01em;
        }

        .accordion-trigger:hover {
            color: var(--accent-orange-light);
        }

        .accordion-trigger:focus-visible {
            outline: 2px solid var(--accent-orange);
            outline-offset: -2px;
            border-radius: var(--radius-md);
        }

        .accordion-icon {
            width: 22px;
            height: 22px;
            position: relative;
            flex-shrink: 0;
            margin-left: 1rem;
            color: var(--accent-orange);
        }

        .accordion-icon::before,
        .accordion-icon::after {
            content: '';
            position: absolute;
            background: currentColor;
            transition: transform 0.3s ease, opacity 0.3s ease;
            border-radius: 1px;
        }

        .accordion-icon::before {
            width: 12px;
            height: 2px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .accordion-icon::after {
            width: 2px;
            height: 12px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        .accordion-item.active .accordion-icon::after {
            transform: translate(-50%, -50%) rotate(90deg);
            opacity: 0;
        }

        .accordion-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), padding 0.45s ease;
        }

        .accordion-item.active .accordion-content {
            max-height: 600px;
        }

        .accordion-body {
            padding: 0 1.5rem 1.5rem;
            color: var(--text-secondary);
            line-height: 1.85;
            font-size: 0.92rem;
        }

        .accordion-body strong {
            color: var(--accent-orange-bright);
            font-weight: 600;
        }

        /* ─── FOOTER ─── */
        .site-footer {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--border-subtle);
            padding: 2.5rem 1.5rem;
            text-align: center;
        }

        .footer-text {
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.6;
        }

        /* ─── SCROLL REVEAL ─── */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.9s ease, transform 0.9s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ─── RESPONSIVE ─── */
        @media (max-width: 768px) {
            .hero-header {
                min-height: 55vh;
                padding: 3rem 1rem;
            }

            .hero-glass {
                padding: 2rem 1.5rem;
            }

            .theme-toggle {
                width: 42px;
                height: 42px;
                top: 0.75rem;
                right: 0.75rem;
            }

            .product-grid, .related-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.75rem;
            }

            .product-info, .related-info {
                padding: 1rem;
            }

            .product-name, .related-name {
                font-size: 0.82rem;
            }

            .video-grid {
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }

            .main-container {
                padding: 0 1rem;
            }

            .intro-glass,
            .subcategory-header,
            .section-header {
                padding: 1.5rem;
            }
        }

        @media (max-width: 360px) {
            .product-grid, .related-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ─── ACCESSIBILITY ─── */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
            .page-bg {
                background-attachment: scroll;
            }
        }

        /* ─── PRINT ─── */
        @media print {
            .page-bg, .theme-toggle { display: none; }
            .hero-header { min-height: auto; background: #000; }
            .particles { display: none; }
            .product-card, .related-card { break-inside: avoid; }
            .glass-card { background: #111; border: 1px solid #333; }
        }

        /* ─── FOOTER DIVIDER & POLICY LINKS ─── */
        .footer-divider {
            width: 100%;
            max-width: 800px;
            margin: 0 auto 2rem;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border-orange), transparent);
            opacity: 0.6;
        }

        .footer-policies {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .footer-policies a {
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            transition: color 0.3s ease;
            position: relative;
        }

        .footer-policies a::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--accent-orange);
            transition: width 0.3s ease;
        }

        .footer-policies a:hover {
            color: var(--accent-orange-light);
        }

        .footer-policies a:hover::after {
            width: 100%;
        }

        @media (max-width: 640px) {
            .footer-policies {
                gap: 1rem;
                padding: 0 1rem;
            }
            .footer-policies a {
                font-size: 0.75rem;
            }
        }
    </style>
