    <style>
        /* ─── DARK MODE VARIABLES (Default) ─── */
        :root {
            --bg-deep: #050505;
            --bg-primary: #0a0a0a;
            --bg-secondary: #111111;
            --bg-card: rgba(20, 20, 20, 0.65);
            --bg-glass: rgba(15, 15, 15, 0.55);
            --bg-glass-hover: rgba(25, 25, 25, 0.75);
            --accent-orange: #ff6b00;
            --accent-orange-light: #ff8c00;
            --accent-orange-bright: #ffaa33;
            --accent-orange-glow: rgba(255, 107, 0, 0.25);
            --accent-orange-glow-strong: rgba(255, 107, 0, 0.45);
            --text-primary: #ffffff;
            --text-secondary: #c0c0c0;
            --text-muted: #666666;
            --border-subtle: rgba(255, 255, 255, 0.06);
            --border-orange: rgba(255, 107, 0, 0.25);
            --border-orange-strong: rgba(255, 107, 0, 0.5);
            --shadow-orange: 0 8px 32px rgba(255, 107, 0, 0.12);
            --shadow-orange-lg: 0 12px 48px rgba(255, 107, 0, 0.18);
            --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.3);
            --shadow-card-hover: 0 12px 40px rgba(0, 0, 0, 0.4);
            --glass-blur: blur(20px) saturate(1.2);
            --glass-blur-heavy: blur(40px) saturate(1.4);
            --radius-sm: 10px;
            --radius-md: 18px;
            --radius-lg: 28px;
            --transition-smooth: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-bounce: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            --font-display: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            --font-body: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            --toggle-bg: rgba(255, 255, 255, 0.08);
            --toggle-icon: #ffffff;
            --hero-overlay: rgba(5, 5, 5, 0.88);
            --hero-overlay-mid: rgba(5, 5, 5, 0.75);
        }

        /* ─── LIGHT MODE VARIABLES ─── */
        [data-theme="light"] {
            --bg-deep: #f5f5f7;
            --bg-primary: #ffffff;
            --bg-secondary: #f0f0f2;
            --bg-card: rgba(255, 255, 255, 0.72);
            --bg-glass: rgba(255, 255, 255, 0.65);
            --bg-glass-hover: rgba(255, 255, 255, 0.85);
            --accent-orange: #e65100;
            --accent-orange-light: #ff6b00;
            --accent-orange-bright: #ff8c00;
            --accent-orange-glow: rgba(255, 107, 0, 0.15);
            --accent-orange-glow-strong: rgba(255, 107, 0, 0.3);
            --text-primary: #1a1a1a;
            --text-secondary: #555555;
            --text-muted: #999999;
            --border-subtle: rgba(0, 0, 0, 0.06);
            --border-orange: rgba(255, 107, 0, 0.2);
            --border-orange-strong: rgba(255, 107, 0, 0.4);
            --shadow-orange: 0 8px 32px rgba(255, 107, 0, 0.08);
            --shadow-orange-lg: 0 12px 48px rgba(255, 107, 0, 0.12);
            --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.08);
            --shadow-card-hover: 0 8px 32px rgba(0, 0, 0, 0.12);
            --glass-blur: blur(24px) saturate(1.3);
            --toggle-bg: rgba(0, 0, 0, 0.06);
            --toggle-icon: #1a1a1a;
            --hero-overlay: rgba(245, 245, 247, 0.92);
            --hero-overlay-mid: rgba(245, 245, 247, 0.82);
        }

        /* ─── RESET & BASE ─── */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-body);
            background: var(--bg-deep);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background 0.5s ease, color 0.5s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ─── THEME TOGGLE BUTTON ─── */
        .theme-toggle {
            position: fixed;
            top: 1.25rem;
            right: 1.25rem;
            z-index: 1000;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--bg-glass);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-subtle);
            box-shadow: var(--shadow-card);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-smooth);
            color: var(--toggle-icon);
        }

        .theme-toggle:hover {
            transform: scale(1.1);
            border-color: var(--border-orange);
            box-shadow: var(--shadow-orange);
        }

        .theme-toggle:active {
            transform: scale(0.95);
        }

        .theme-toggle svg {
            width: 22px;
            height: 22px;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .theme-toggle:hover svg {
            transform: rotate(20deg);
        }

        [data-theme="light"] .theme-toggle .moon { display: none; }
        [data-theme="light"] .theme-toggle .sun { display: block; }
        :root:not([data-theme="light"]) .theme-toggle .moon { display: block; }
        :root:not([data-theme="light"]) .theme-toggle .sun { display: none; }
        /* ─── BACK TO HOME BUTTON ─── */
        .back-home {
            position: fixed;
            top: 1.25rem;
            left: 1.25rem;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.1rem;
            background: var(--bg-glass);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-subtle);
            border-radius: 100px;
            box-shadow: var(--shadow-card);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            text-decoration: none;
            cursor: pointer;
            transition: var(--transition-smooth);
        }

        .back-home:hover {
            transform: translateX(-3px);
            border-color: var(--border-orange);
            box-shadow: var(--shadow-orange);
            color: var(--accent-orange-light);
        }

        .back-home:active {
            transform: scale(0.95);
        }

        .back-home svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .back-home:hover svg {
            transform: translateX(-3px);
        }

        @media (max-width: 768px) {
            .back-home {
                top: 0.75rem;
                left: 0.75rem;
                padding: 0.55rem 0.9rem;
                font-size: 0.8rem;
            }
            .back-home svg {
                width: 16px;
                height: 16px;
            }
        }

        /* ─── BACK TO HOME BUTTON ─── */
