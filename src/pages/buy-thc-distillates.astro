        /* ─── BACKGROUND IMAGE LAYER ─── */
        /* ═══ EDIT: Change the background-image URL below to your GitHub raw image URL ═══ */
        .page-bg {
            position: fixed;
            inset: 0;
            z-index: -2;
            background-image: url('https://images.unsplash.com/photo-1557682250-33bd709cbe85?w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            transition: filter 0.5s ease;
        }

        /* Light mode makes background softer */
        [data-theme="light"] .page-bg {
            filter: brightness(1.3) saturate(0.7);
        }

        .page-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                180deg,
                var(--hero-overlay) 0%,
                var(--hero-overlay-mid) 40%,
                var(--hero-overlay-mid) 70%,
                var(--hero-overlay) 100%
            );
            transition: background 0.5s ease;
        }

        /* ─── ANIMATED HERO HEADER ─── */
        .hero-header {
            position: relative;
            min-height: 65vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 5rem 1.5rem;
            overflow: hidden;
        }

        .hero-glass {
            position: relative;
            z-index: 2;
            background: var(--bg-glass);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            padding: 3.5rem 3rem;
            max-width: 800px;
            width: 100%;
            box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            animation: glassReveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
            transition: background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
        }

        @keyframes glassReveal {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.96);
                backdrop-filter: blur(0px);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
                backdrop-filter: var(--glass-blur);
            }
        }

        /* Floating particles */
        .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 1;
        }

        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: var(--accent-orange);
            border-radius: 50%;
            opacity: 0;
            box-shadow: 0 0 10px var(--accent-orange-glow);
            animation: floatParticle 10s infinite ease-in-out;
        }

        @keyframes floatParticle {
            0%, 100% { opacity: 0; transform: translateY(100vh) scale(0); }
            10% { opacity: 0.5; }
            90% { opacity: 0.5; }
            50% { transform: translateY(-10vh) scale(1); }
        }

        /* Main H1 */
        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(2.2rem, 7vw, 4.8rem);
            font-weight: 900;
            letter-spacing: -0.03em;
            line-height: 1.05;
            margin-bottom: 1rem;
        }

        .hero-title .word {
            display: inline-block;
            background: linear-gradient(
                135deg, 
                var(--accent-orange) 0%, 
                var(--accent-orange-light) 40%, 
                var(--accent-orange-bright) 70%,
                var(--accent-orange) 100%
            );
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: 
                titleReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards,
                gradientShift 4s ease infinite;
            opacity: 0;
            transform: translateY(40px) rotateX(-20deg);
        }

        .hero-title .word:nth-child(1) { animation-delay: 0.1s, 0s; }
        .hero-title .word:nth-child(2) { animation-delay: 0.3s, 0s; }
        .hero-title .word:nth-child(3) { animation-delay: 0.5s, 0s; }

        @keyframes titleReveal {
            to { opacity: 1; transform: translateY(0) rotateX(0); }
        }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .hero-line {
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-orange), var(--accent-orange-bright));
            border-radius: 2px;
            margin: 0 auto 1.25rem;
            opacity: 0;
            animation: expandLine 0.8s ease 0.8s forwards;
            transform: scaleX(0);
            box-shadow: 0 0 20px var(--accent-orange-glow);
        }

        @keyframes expandLine {
            to { opacity: 1; transform: scaleX(1); }
        }

        .hero-subtitle {
            font-size: clamp(0.95rem, 2.5vw, 1.2rem);
            color: var(--text-secondary);
            max-width: 520px;
            margin: 0 auto;
            opacity: 0;
            animation: fadeSlideUp 1s ease 0.7s forwards;
            font-weight: 400;
            letter-spacing: 0.01em;
            line-height: 1.6;
        }

        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ─── MAIN CONTENT ─── */
        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* ─── GLASS CARD COMPONENT ─── */
        .glass-card {
            background: var(--bg-glass);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.04);
            transition: var(--transition-smooth);
        }

        .glass-card:hover {
            background: var(--bg-glass-hover);
            border-color: var(--border-orange);
            box-shadow: var(--shadow-card-hover), 0 0 30px var(--accent-orange-glow), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        /* ─── INTRO TEXT SECTION ─── */
        .intro-section {
            padding: 3rem 0 2.5rem;
        }

        .intro-glass {
            padding: 2.5rem 2rem;
            text-align: center;
        }

        .intro-text {
            font-size: 1.05rem;
            color: var(--text-secondary);
            max-width: 780px;
            margin: 0 auto;
            line-height: 1.85;
        }

        .intro-text strong {
            color: var(--accent-orange-light);
            font-weight: 600;
        }

        /* ─── SUB-CATEGORY SECTIONS ─── */
        .subcategory-section {
            padding: 2.5rem 0;
        }

        .subcategory-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
        }

        .subcategory-badge {
            display: inline-block;
            padding: 0.35rem 1rem;
            background: linear-gradient(135deg, rgba(255, 107, 0, 0.12), rgba(255, 140, 0, 0.08));
            border: 1px solid var(--border-orange);
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--accent-orange-light);
            margin-bottom: 0.875rem;
            backdrop-filter: blur(10px);
        }

        .subcategory-title {
            font-size: clamp(1.4rem, 4vw, 2rem);
            font-weight: 800;
            margin-bottom: 0.625rem;
            background: linear-gradient(135deg, var(--text-primary), var(--accent-orange-bright));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subcategory-desc {
            color: var(--text-secondary);
            max-width: 560px;
            margin: 0 auto;
            font-size: 0.92rem;
            line-height: 1.7;
        }

        /* ─── PRODUCT GRID ─── */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.25rem;
            margin-top: 1.5rem;
        }

        @media (max-width: 640px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.875rem;
            }
        }

        @media (max-width: 360px) {
            .product-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ─── PRODUCT CARD ─── */
        .product-card {
            composes: glass-card;
            overflow: hidden;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            border-radius: var(--radius-md);
        }

        .product-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 107, 0, 0.04), transparent 60%);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 1;
        }

        .product-card:hover::before {
            opacity: 1;
        }

        .product-card:hover {
            transform: translateY(-8px);
            border-color: var(--border-orange-strong);
            box-shadow: var(--shadow-orange-lg);
        }

        .product-card:active {
            transform: translateY(-3px) scale(0.98);
        }

        .product-image-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            background: linear-gradient(135deg, rgba(20,20,20,0.8), rgba(30,30,30,0.6));
        }

        [data-theme="light"] .product-image-wrap {
            background: linear-gradient(135deg, rgba(240,240,240,0.8), rgba(230,230,230,0.6));
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .product-card:hover .product-image {
            transform: scale(1.1);
        }

        .product-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 1.25rem;
            opacity: 0;
            transition: opacity 0.35s ease;
            z-index: 2;
        }

        .product-card:hover .product-overlay {
            opacity: 1;
        }

        .view-btn {
            background: linear-gradient(135deg, var(--accent-orange), var(--accent-orange-light));
            color: #fff;
            padding: 0.65rem 1.75rem;
            border-radius: 100px;
            font-weight: 800;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            box-shadow: 0 4px 20px rgba(255, 107, 0, 0.4);
            transform: translateY(12px);
            transition: var(--transition-bounce);
            border: none;
        }

        .product-card:hover .view-btn {
            transform: translateY(0);
        }

        .product-info {
            padding: 1.25rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            z-index: 2;
        }

        .product-name {
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.4;
            margin-bottom: 0.625rem;
            transition: color 0.3s ease;
