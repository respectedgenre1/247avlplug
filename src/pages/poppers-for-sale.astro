        /* ─── THEME TOGGLE ─── */
        .theme-toggle { position: fixed; top: 1.25rem; right: 1.25rem; z-index: 1000; width: 48px; height: 48px; border-radius: 50%; background: var(--bg-glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-card); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--transition-smooth); color: var(--toggle-icon); }
        .theme-toggle:hover { transform: scale(1.1); border-color: var(--border-orange); box-shadow: var(--shadow-orange); }
        .theme-toggle:active { transform: scale(0.95); }
        .theme-toggle svg { width: 22px; height: 22px; transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
        .theme-toggle:hover svg { transform: rotate(20deg); }
        [data-theme="light"] .theme-toggle .moon { display: none; } [data-theme="light"] .theme-toggle .sun { display: block; }
        :root:not([data-theme="light"]) .theme-toggle .moon { display: block; } :root:not([data-theme="light"]) .theme-toggle .sun { display: none; }

        /* ─── BACKGROUND ─── */
        .page-bg { position: fixed; inset: 0; z-index: -2; background-image: url('https://images.unsplash.com/photo-1557682250-33bd709cbe85?w=1920&q=80'); background-size: cover; background-position: center; background-attachment: fixed; background-repeat: no-repeat; transition: filter 0.5s ease; }
        [data-theme="light"] .page-bg { filter: brightness(1.3) saturate(0.7); }
        .page-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--hero-overlay) 0%, var(--hero-overlay-mid) 40%, var(--hero-overlay-mid) 70%, var(--hero-overlay) 100%); transition: background 0.5s ease; }

        /* ─── HERO ─── */
        .hero-header { position: relative; min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 5rem 1.5rem; overflow: hidden; }
        .hero-glass { position: relative; z-index: 2; background: var(--bg-glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 3.5rem 3rem; max-width: 800px; width: 100%; box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.05); animation: glassReveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both; transition: background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease; }
        @keyframes glassReveal { from { opacity: 0; transform: translateY(30px) scale(0.96); backdrop-filter: blur(0px); } to { opacity: 1; transform: translateY(0) scale(1); backdrop-filter: var(--glass-blur); } }
        .particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }
        .particle { position: absolute; width: 3px; height: 3px; background: var(--accent-orange); border-radius: 50%; opacity: 0; box-shadow: 0 0 10px var(--accent-orange-glow); animation: floatParticle 10s infinite ease-in-out; }
        @keyframes floatParticle { 0%, 100% { opacity: 0; transform: translateY(100vh) scale(0); } 10% { opacity: 0.5; } 90% { opacity: 0.5; } 50% { transform: translateY(-10vh) scale(1); } }
        .hero-title { font-size: clamp(2.2rem, 7vw, 4.8rem); font-weight: 900; letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 1rem; }
        .hero-title .word { display: inline-block; background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-orange-light) 40%, var(--accent-orange-bright) 70%, var(--accent-orange) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: titleReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards, gradientShift 4s ease infinite; opacity: 0; transform: translateY(40px) rotateX(-20deg); }
        .hero-title .word:nth-child(1) { animation-delay: 0.1s, 0s; } .hero-title .word:nth-child(2) { animation-delay: 0.3s, 0s; }
        @keyframes titleReveal { to { opacity: 1; transform: translateY(0) rotateX(0); } } @keyframes gradientShift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
        .hero-line { width: 60px; height: 3px; background: linear-gradient(90deg, var(--accent-orange), var(--accent-orange-bright)); border-radius: 2px; margin: 0 auto 1.25rem; opacity: 0; animation: expandLine 0.8s ease 0.8s forwards; transform: scaleX(0); box-shadow: 0 0 20px var(--accent-orange-glow); }
        @keyframes expandLine { to { opacity: 1; transform: scaleX(1); } }
        .hero-subtitle { font-size: clamp(0.95rem, 2.5vw, 1.2rem); color: var(--text-secondary); max-width: 520px; margin: 0 auto; opacity: 0; animation: fadeSlideUp 1s ease 0.7s forwards; font-weight: 400; letter-spacing: 0.01em; line-height: 1.6; }
        @keyframes fadeSlideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        /* ─── GLASS CARD ─── */
        .glass-card { background: var(--bg-glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.04); transition: var(--transition-smooth); }
