        /* ─── BACK TO HOME ─── */
        .back-home { position: fixed; top: 1.25rem; left: 1.25rem; z-index: 1000; display: flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.1rem; background: var(--bg-glass); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border: 1px solid var(--border-subtle); border-radius: 100px; box-shadow: var(--shadow-card); color: var(--text-primary); font-family: inherit; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; transition: var(--transition-smooth); }
        .back-home:hover { transform: translateX(-3px); border-color: var(--border-orange); box-shadow: var(--shadow-orange); color: var(--accent-orange-light); }
        .back-home:active { transform: scale(0.95); }
