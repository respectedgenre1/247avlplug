        function openInfo(key) {
            const p = PRODUCT_INFO[key]; if (!p) return;
            document.getElementById('infoModalImg').src = p.img;
            document.getElementById('infoModalImg').alt = p.name;
            document.getElementById('infoModalTitle').textContent = p.name;
            document.getElementById('infoModalBody').innerHTML = p.desc;
            document.getElementById('infoModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeInfo() {
            document.getElementById('infoModal').classList.remove('open');
            document.body.style.overflow = '';
        }

        /* ─── MINI CART ─── */
        const WA_NUMBER = '114313046433';
        const TG_USER = 'datplugg';
        function getCart() {
            return Array.from(document.querySelectorAll('.cart-check:checked')).map(cb => ({
                name: cb.dataset.name, price: parseFloat(cb.dataset.price)
            }));
        }
        function updateCart() {
            const cart = getCart();
            const count = cart.length;
            const total = cart.reduce((s, i) => s + i.price, 0);
            document.getElementById('cartCount').textContent = count;
            document.getElementById('cartTotal').textContent = '$' + total;
            const mc = document.getElementById('miniCart');
            mc.classList.remove('bump'); void mc.offsetWidth; mc.classList.add('bump');
            renderCartModal(cart, total);
        }
        function renderCartModal(cart, total) {
            const box = document.getElementById('cartItems');
            if (!cart.length) {
                box.innerHTML = '<p class="cart-empty">Your cart is empty.<br>Tick the box on any product to add it here.</p>';
            } else {
                box.innerHTML = cart.map((i, idx) =>
                    '<div class="cart-item"><span class="cart-item-name">' + (idx + 1) + '. ' + i.name +
                    '</span><span class="cart-item-price">$' + i.price.toFixed(2) +
                    '</span><button type="button" class="cart-item-remove" data-remove="' + idx + '" aria-label="Remove">×</button></div>'
                ).join('');
            }
            document.getElementById('cartModalTotal').textContent = '$' + total.toFixed(2);
            const lines = cart.map((i, idx) => (idx + 1) + '. ' + i.name + ' — $' + i.price.toFixed(2)).join('\n');
            const msg = 'Hello 247AVL Plug! I would like to order:\n\n' + (lines || '(cart is empty)') +
                        '\n\nTotal: $' + total.toFixed(2) + '\n\nPlease confirm availability and payment details.';
            document.getElementById('orderWhatsApp').href = 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(msg);
            document.getElementById('orderTelegram').href = 'https://t.me/' + TG_USER + '?text=' + encodeURIComponent(msg);
        }
        function removeItem(idx) {
            const checked = document.querySelectorAll('.cart-check:checked');
            if (checked[idx]) checked[idx].checked = false;
            updateCart();
        }
        function clearCart() {
            document.querySelectorAll('.cart-check:checked').forEach(cb => cb.checked = false);
            updateCart();
        }
        function openCart() {
            renderCartModal(getCart(), getCart().reduce((s, i) => s + i.price, 0));
            document.getElementById('cartModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeCart() {
            document.getElementById('cartModal').classList.remove('open');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') { closeInfo(); closeCart(); }
        });
        /* Event delegation — works even where inline handlers are blocked */
        document.addEventListener('click', function(e) {
            const infoBtn = e.target.closest('[data-info]');
            if (infoBtn) { e.preventDefault(); openInfo(infoBtn.dataset.info); return; }
            const closer = e.target.closest('[data-close]');
            if (closer) { closer.dataset.close === 'info' ? closeInfo() : closeCart(); return; }
            const remover = e.target.closest('[data-remove]');
            if (remover) { removeItem(parseInt(remover.dataset.remove, 10)); return; }
            const backdrop = e.target.closest('[data-backdrop]');
            if (backdrop && e.target === backdrop) { backdrop.dataset.backdrop === 'info' ? closeInfo() : closeCart(); return; }
            if (e.target.closest('[data-clear-cart]')) { clearCart(); return; }
            if (e.target.closest('#miniCart')) { openCart(); }
        });
        document.addEventListener('change', function(e) {
            if (e.target.classList && e.target.classList.contains('cart-check')) updateCart();
        });
    </script>

