            --accent-orange: #e65100; --accent-orange-light: #ff6b00; --accent-orange-bright: #ff8c00;
            --accent-orange-glow: rgba(255, 107, 0, 0.15); --accent-orange-glow-strong: rgba(255, 107, 0, 0.3);
