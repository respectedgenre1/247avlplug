            transition: all 0.2s ease;
        }
        .tier-option:hover {
            border-color: #25D366;
            background-color: #f0fff4;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.2);
        }
        .tier-option.selected {
            border-color: #25D366;
