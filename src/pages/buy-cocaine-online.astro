</head>
<body>

    <header>
        <a href="/" class="back-btn">← Back to Shop</a>
        <h1 class="header-title">Premium GPS Tracker</h1>
    </header>

    <main>
        <article>
            <div class="card product-image-container">
                <img src="/images/gps-tracker.jpg" alt="Premium compact GPS tracker for vehicles" class="product-image" width="600" height="600">
            </div>

            <section class="card product-details">
                <h2 class="product-title">Premium GPS Tracker</h2>
                
                <!-- FLOATING FEATURE BUBBLES -->
                <div class="feature-bubbles">
                    <div class="feature-bubble">
                        <span class="feature-bubble-icon">✓</span>
                        <span>Real-time live tracking</span>
                    </div>
                    <div class="feature-bubble">
                        <span class="feature-bubble-icon">✓</span>
                        <span>30-day battery life</span>
                    </div>
                    <div class="feature-bubble">
                        <span class="feature-bubble-icon">✓</span>
                        <span>Geofencing alerts</span>
                    </div>
                    <div class="feature-bubble">
                        <span class="feature-bubble-icon">✓</span>
                        <span>Plug-and-play install</span>
                    </div>
                </div>

                <p class="product-description">Keep your vehicle secure with our Premium GPS Tracker. Features real-time location updates, geofencing alerts, and a 30-day battery life. Perfect for personal cars, fleets, and motorcycles.</p>

                <div class="section-title">Choose Your Package</div>
                <div class="pricing-tiers">
                    <div class="tier-option selected" onclick="selectTier(this, 'Single Unit', '$49.99')">
                        <span class="tier-label">Single Unit</span>
                        <span class="tier-price">$49.99</span>
                    </div>
                    <div class="tier-option" onclick="selectTier(this, '5-Pack', '$224.99')">
                        <span class="tier-label">5-Pack <span class="tier-badge">Save 10%</span></span>
                        <span class="tier-price">$224.99</span>
                    </div>
                    <div class="tier-option" onclick="selectTier(this, '10-Pack', '$399.99')">
                        <span class="tier-label">10-Pack <span class="tier-badge">Best Value</span></span>
                        <span class="tier-price">$399.99</span>
                    </div>
                    <div class="tier-option" onclick="selectTier(this, 'Wholesale (50+)', 'Contact for Quote')">
                        <span class="tier-label">Wholesale (50+) <span class="tier-badge">Bulk</span></span>
                        <span class="tier-price">Contact for Quote</span>
                    </div>
                    <div class="tier-option" onclick="selectTier(this, 'Custom Bundle', 'Contact for Quote')">
                        <span class="tier-label">Custom Bundle</span>
                        <span class="tier-price">Contact for Quote</span>
                    </div>
                </div>

                <div class="buy-buttons">
                    <a id="btn-wa" href="https://wa.me/1234567890?text=Hi!%20I%20want%20to%20buy%20the%20Premium%20GPS%20Tracker%20(Single%20Unit%20-%20$49.99)%20from%20247avlplug.com" class="contact-btn btn-whatsapp" target="_blank" rel="noopener">💬 WhatsApp</a>
                    <a id="btn-email" href="mailto:sales@247avlplug.com?subject=Inquiry:%20Premium%20GPS%20Tracker%20(Single%20Unit)&body=Hi,%20I%20would%20like%20to%20purchase%20the%20Premium%20GPS%20Tracker%20-%20Single%20Unit%20at%20$49.99%20from%20your%20store." class="contact-btn btn-email">✉️ Email</a>
                </div>
            </section>
        </article>
    </main>

    <script>
        function selectTier(element, label, price) {
            var tiers = document.querySelectorAll('.tier-option');
            for (var i = 0; i < tiers.length; i++) {
                tiers[i].classList.remove('selected');
            }
            element.classList.add('selected');
            
            var productName = 'Premium GPS Tracker';
            var waMessage = encodeURIComponent('Hi! I want to buy the ' + productName + ' (' + label + ' - ' + price + ') from 247avlplug.com');
            document.getElementById('btn-wa').href = 'https://wa.me/1234567890?text=' + waMessage;
            
            var emailSubject = encodeURIComponent('Inquiry: ' + productName + ' (' + label + ')');
            var emailBody = encodeURIComponent('Hi, I would like to purchase the ' + productName + ' - ' + label + ' at ' + price + ' from your store.');
            document.getElementById('btn-email').href = 'mailto:sales@247avlplug.com?subject=' + emailSubject + '&body=' + emailBody;
        }
    </script>

</body>
