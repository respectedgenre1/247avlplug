            transition: all 0.2s ease;
            border: none;
            cursor: pointer;
        }
        .contact-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }
        
        .btn-whatsapp {
            background-color: #25D366;
            color: white;
        }
        .btn-whatsapp:hover {
            background-color: #20bd5a;
        }
        
        .btn-email {
            background-color: #ffffff;
            color: #1d1d1f;
            border: 2px solid #e0e0e0;
        }
        .btn-email:hover {
            background-color: #f5f5f5;
            border-color: #25D366;
        }

        @media (min-width: 768px) {
            main { padding: 40px 30px 60px; }
            
            article {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 30px;
                align-items: start;
            }

            .product-image-container {
                position: sticky;
                top: 100px;
            }
            
            .product-details {
                padding: 40px 36px;
            }
            .product-title { font-size: 38px; }
            .product-description { font-size: 17px; }
        }

        @media (min-width: 1200px) {
            main { max-width: 1280px; padding: 50px 40px 80px; }
            article { gap: 40px; }
