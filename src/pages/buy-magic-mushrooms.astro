function avlCalculatePrice(base, grams, discount) {
    const unitPrice = base / 30;
    const raw = unitPrice * grams;
    return Math.round(raw * (1 - discount));
}

function avlFormatPrice(num) {
    return '$' + num.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
}

const avlGrid = document.getElementById('avlProductGrid');
