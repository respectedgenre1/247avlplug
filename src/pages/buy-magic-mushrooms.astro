const qtyOptions = [
    {g:30, discount:0, label:'30g'},
    {g:60, discount:0.02, label:'60g'},
    {g:100, discount:0.04, label:'100g'},
    {g:250, discount:0.06, label:'250g'},
    {g:500, discount:0.08, label:'500g'},
    {g:1000, discount:0.10, label:'1000g (1kg)'}
];

function calculatePrice(base, grams, discount) {
    const unitPrice = base / 30;
    const raw = unitPrice * grams;
    return Math.round(raw * (1 - discount));
}

function formatPrice(num) {
    return '$' + num.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
}

const grid = document.getElementById('productGrid');
products.forEach(p => {
    const card = document.createElement('article');
    card.className = 'product-card';
    card.setAttribute('role', 'listitem');
    card.setAttribute('data-id', p.id);
    
    let selectHtml = '<select class="qty-select" onchange="updatePrice(this,\''+p.id+'\')">';
    qtyOptions.forEach((q,i) => {
        const price = calculatePrice(p.basePrice, q.g, q.discount);
        selectHtml += `<option value="${q.g}" data-discount="${q.discount}" data-price="${price}" ${i===0?'selected':''}>${q.label} — ${formatPrice(price)}</option>`;
    });
    selectHtml += '</select>';
    
    const potencyClass = p.potency === 'Beginner' ? 'potency-beginner' : p.potency === 'Intermediate' ? 'potency-intermediate' : 'potency-advanced';
    
    card.innerHTML = `
        <div class="product-image-wrap">
            <span class="product-potency ${potencyClass}">${p.potency}</span>
            <img src="${p.image}" alt="${p.name}" class="product-image" loading="lazy" onerror="this.src='https://via.placeholder.com/400x300/1a1a1a/ff6b00?text=${encodeURIComponent(p.name.split(' ').slice(0,2).join('+'))}'">
        </div>
        <div class="product-info">
            <h3 class="product-name">${p.name}</h3>
            ${selectHtml}
            <div class="product-actions">
                <button class="btn-info" onclick="openInfo('${p.id}')" aria-label="Info about ${p.name}">ℹ</button>
                <button class="btn-add" onclick="addToCart('${p.id}')" id="btn-${p.id}">
                    <span>🍄</span> Add to Basket
                </button>
            </div>
        </div>
    `;
    grid.appendChild(card);
});

function updatePrice(select, id) {}

// ═══════════════════════════════════════════════════════════════════════
// CART SYSTEM
// ═══════════════════════════════════════════════════════════════════════
let cart = JSON.parse(localStorage.getItem('mushroomCart') || '[]');

function saveCart() {
    localStorage.setItem('mushroomCart', JSON.stringify(cart));
    renderCart();
}

function addToCart(id) {
    const product = products.find(p => p.id === id);
    const card = document.querySelector(`[data-id="${id}"]`);
    const select = card.querySelector('.qty-select');
    const opt = select.options[select.selectedIndex];
    const grams = parseInt(opt.value);
    const discount = parseFloat(opt.dataset.discount);
    const price = calculatePrice(product.basePrice, grams, discount);
    
    const existing = cart.find(item => item.id === id && item.grams === grams);
    if (existing) {
        existing.qty += 1;
    } else {
        cart.push({ id, name: product.name, grams, price, image: product.image, qty: 1 });
    }
    
    const btn = document.getElementById(`btn-${id}`);
    btn.innerHTML = '<span>✓</span> Added!';
    btn.classList.add('added');
    setTimeout(() => {
        btn.innerHTML = '<span>🍄</span> Add to Basket';
        btn.classList.remove('added');
    }, 1500);
    
    saveCart();
    document.getElementById('cartBar').classList.add('active');
}

function removeFromCart(index) {
    cart.splice(index, 1);
    saveCart();
}

function renderCart() {
    const count = cart.reduce((sum, item) => sum + item.qty, 0);
    const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
    
    document.getElementById('cartCount').textContent = count;
    document.getElementById('cartTotalDisplay').textContent = formatPrice(total);
    document.getElementById('grandTotal').textContent = formatPrice(total);
    
    const container = document.getElementById('cartItemsContainer');
    const footer = document.getElementById('cartFooter');
    
    if (cart.length === 0) {
        container.innerHTML = '<div class="cart-empty">Your basket is empty. Select strains and quantities above.</div>';
        footer.style.display = 'none';
        document.getElementById('cartBar').classList.remove('active');
        return;
    }
    
    footer.style.display = 'block';
    document.getElementById('cartBar').classList.add('active');
    
    container.innerHTML = cart.map((item, i) => `
        <div class="cart-item">
            <img src="${item.image}" alt="" onerror="this.style.display='none'">
            <div class="cart-item-info">
                <div class="cart-item-name">${item.name}</div>
                <div class="cart-item-meta">${item.grams}g × ${item.qty}</div>
            </div>
            <div class="cart-item-price">${formatPrice(item.price * item.qty)}</div>
            <button class="cart-item-remove" onclick="removeFromCart(${i})" aria-label="Remove item">×</button>
        </div>
    `).join('');
}

function generateOrderText() {
    let text = `🍄 *NEW ORDER — 247AVL Plug*%0A%0A`;
    cart.forEach(item => {
        text += `• ${item.name}%0A  ${item.grams}g × ${item.qty} = *${formatPrice(item.price * item.qty)}*%0A%0A`;
    });
    text += `*Grand Total: ${formatPrice(cart.reduce((s,i)=>s+(i.price*i.qty),0))}*%0A%0APlease reply with your shipping details to complete the order.`;
    return text;
}

