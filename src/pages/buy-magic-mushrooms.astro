// ═══════════════════════════════════════════════════════════════════════
// THEME TOGGLE
// ═══════════════════════════════════════════════════════════════════════
(function() {
    const toggle = document.getElementById('themeToggle');
    const metaTheme = document.getElementById('themeColorMeta');
    const html = document.documentElement;
    const savedTheme = localStorage.getItem('theme');
    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'light' || (!savedTheme && !systemPrefersDark)) {
        html.setAttribute('data-theme', 'light');
        metaTheme.setAttribute('content', '#f5f5f7');
    }
    toggle.addEventListener('click', function() {
        const isLight = html.getAttribute('data-theme') === 'light';
        if (isLight) { html.removeAttribute('data-theme'); localStorage.setItem('theme', 'dark'); metaTheme.setAttribute('content', '#0a0a0a'); }
        else { html.setAttribute('data-theme', 'light'); localStorage.setItem('theme', 'light'); metaTheme.setAttribute('content', '#f5f5f7'); }
    });
})();

