// ═══════════════════════════════════════════════════════════════════════
// ║  PRICING LOGIC — 2% incremental discount 60g–500g                   ║
// ═══════════════════════════════════════════════════════════════════════
const quantities = [
    { g: 30,  mult: 1,    discount: 1.00 },
    { g: 60,  mult: 2,    discount: 0.98 },
    { g: 100, mult: 3.333, discount: 0.96 },
    { g: 250, mult: 8.333, discount: 0.94 },
    { g: 500, mult: 16.667, discount: 0.92 },
    { g: 1000, mult: 33.333, discount: 0.88 }
];

function getPrice(base, grams) {
    const q = quantities.find(x => x.g === grams);
    return Math.round(base * q.mult * q.discount);
}

// ═══════════════════════════════════════════════════════════════════════
// ║  RENDER PRODUCTS                                                    ║
// ═══════════════════════════════════════════════════════════════════════
function renderProducts() {
    const grid = document.getElementById('productGrid');
    grid.innerHTML = products.map(p => {
        const options = quantities.map(q => {
            const price = getPrice(p.basePrice, q.g);
            return `<option value="${q.g}">${q.g}g — $${price}</option>`;
        }).join('');
        return `
        <div class="product-card glass-card" data-id="${p.id}">
            <div class="product-image-wrap">
                <img src="${p.image}" alt="${p.name}" class="product-image" loading="lazy" onerror="this.src='https://via.placeholder.com/400x400/1a1a1a/ff6b00?text=Shrooms'">
            </div>
            <div class="product-info">
                <h3 class="product-name">${p.name}</h3>
                <div class="product-actions">
                    <button class="info-toggle" onclick="toggleDesc('${p.id}')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        Info
                    </button>
                </div>
                <div class="product-desc" id="desc-${p.id}">${p.desc}</div>
                <select class="qty-select" id="qty-${p.id}">
                    ${options}
                </select>
                <button class="add-cart-btn" onclick="addToCart('${p.id}')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    Add to Basket
                </button>
            </div>
        </div>`;
    }).join('');
}

function toggleDesc(id) {
    const el = document.getElementById('desc-' + id);
    el.classList.toggle('open');
}

// ═══════════════════════════════════════════════════════════════════════
// ║  CART LOGIC                                                         ║
// ═══════════════════════════════════════════════════════════════════════
let cart = [];

function addToCart(id) {
    const product = products.find(p => p.id === id);
    const grams = parseInt(document.getElementById('qty-' + id).value);
    const price = getPrice(product.basePrice, grams);
    const existing = cart.find(item => item.id === id && item.grams === grams);
    if (existing) {
        existing.qty++;
    } else {
        cart.push({ id, name: product.name, grams, price, qty: 1 });
    }
    updateCartUI();
    showCart();
}

function removeFromCart(index) {
    cart.splice(index, 1);
    updateCartUI();
}

function clearCart() {
    cart = [];
    updateCartUI();
    hideCart();
}

function updateCartUI() {
    const itemsEl = document.getElementById('cartItems');
    const countEl = document.getElementById('cartCount');
    const badgeEl = document.getElementById('cartBadge');
    const totalEl = document.getElementById('cartTotal');
    const toggleBtn = document.getElementById('cartToggleBtn');

    const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
    const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

    countEl.textContent = totalItems;
    badgeEl.textContent = totalItems;
    totalEl.textContent = '$' + totalPrice.toLocaleString();

    if (cart.length === 0) {
        itemsEl.innerHTML = '<div style="color:var(--text-muted);font-size:0.85rem;text-align:center;padding:1rem;">Your basket is empty. Add some magic mushrooms!</div>';
        toggleBtn.style.display = 'none';
    } else {
        toggleBtn.style.display = 'flex';
        itemsEl.innerHTML = cart.map((item, i) => `
            <div class="cart-item">
                <div>
                    <div class="cart-item-name">${item.name}</div>
                    <div class="cart-item-qty">${item.qty}x ${item.grams}g @ $${item.price}</div>
                </div>
                <div style="display:flex;align-items:center;gap:0.5rem;">
                    <span class="cart-item-price">$${(item.price * item.qty).toLocaleString()}</span>
                    <span class="cart-item-remove" onclick="removeFromCart(${i})">✕</span>
                </div>
            </div>
        `).join('');
    }
}

function toggleCart() {
    const section = document.getElementById('cartSection');
    section.classList.toggle('hidden');
}
function showCart() {
    document.getElementById('cartSection').classList.remove('hidden');
}
function hideCart() {
    document.getElementById('cartSection').classList.add('hidden');
}

// ═══════════════════════════════════════════════════════════════════════
// ║  SEND ORDER — WHATSAPP & TELEGRAM                                   ║
// ═══════════════════════════════════════════════════════════════════════
function sendOrder(platform) {
    if (cart.length === 0) return;
    const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
    let msg = `Hi 247AVL Plug, I would like to order the following magic mushrooms:

`;
    cart.forEach(item => {
        msg += `• ${item.name}
  ${item.qty}x ${item.grams}g — $${(item.price * item.qty).toLocaleString()}

`;
    });
    msg += `Total: $${total.toLocaleString()}

Please confirm availability and payment details. Thanks!`;

    if (platform === 'whatsapp') {
        window.open(`https://wa.me/13254365583?text=${encodeURIComponent(msg)}`, '_blank');
    } else {
        window.open(`https://t.me/datplugg?text=${encodeURIComponent(msg)}`, '_blank');
    }
}

// ═══════════════════════════════════════════════════════════════════════
// ║  THEME TOGGLE                                                       ║
// ═══════════════════════════════════════════════════════════════════════
(function() {
    const toggle = document.getElementById('themeToggle');
    const metaTheme = document.getElementById('themeColorMeta');
    const html = document.documentElement;
    const savedTheme = localStorage.getItem('theme');
    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'light' || (!savedTheme && !systemPrefersDark)) {
        html.setAttribute('data-theme', 'light');
        metaTheme.setAttribute('content', '#f5f5f7');
    }
    toggle.addEventListener('click', function() {
        const isLight = html.getAttribute('data-theme') === 'light';
        if (isLight) {
            html.removeAttribute('data-theme');
            localStorage.setItem('theme', 'dark');
            metaTheme.setAttribute('content', '#0a0a0a');
        } else {
            html.setAttribute('data-theme', 'light');
            localStorage.setItem('theme', 'light');
            metaTheme.setAttribute('content', '#f5f5f7');
        }
    });
})();

// ═══════════════════════════════════════════════════════════════════════
// ║  SCROLL REVEAL                                                      ║
// ═══════════════════════════════════════════════════════════════════════
const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
        }
    });
}, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });

// ═══════════════════════════════════════════════════════════════════════
// ║  INIT                                                               ║
// ═══════════════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
    renderProducts();
    updateCartUI();
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
});
</script>

