// ═══════════════════════════════════════════════════════════════════════
// CART SYSTEM
// ═══════════════════════════════════════════════════════════════════════
let avlCart = JSON.parse(localStorage.getItem('avlMushroomCart') || '[]');

function avlSaveCart() {
    localStorage.setItem('avlMushroomCart', JSON.stringify(avlCart));
    avlRenderCart();
}

function avlAddToCart(id) {
    const product = avlProducts.find(p => p.id === id);
    const card = document.querySelector(`[data-id="${id}"]`);
    const select = card.querySelector('.avl-qty-select');
    const opt = select.options[select.selectedIndex];
    const grams = parseInt(opt.value);
    const discount = parseFloat(opt.dataset.discount);
    const price = avlCalculatePrice(product.basePrice, grams, discount);
    
    const existing = avlCart.find(item => item.id === id && item.grams === grams);
    if (existing) {
        existing.qty += 1;
    } else {
        avlCart.push({ id, name: product.name, grams, price, image: product.image, qty: 1 });
    }
    
    const btn = document.getElementById(`avl-btn-${id}`);
    btn.innerHTML = '<span>✓</span> Added!';
    btn.classList.add('added');
    setTimeout(() => {
        btn.innerHTML = '<span>🍄</span> Add to Basket';
        btn.classList.remove('added');
    }, 1500);
    
    avlSaveCart();
    document.getElementById('avlCartBar').classList.add('active');
}

function avlRemoveFromCart(index) {
    avlCart.splice(index, 1);
    avlSaveCart();
}

function avlRenderCart() {
    const count = avlCart.reduce((sum, item) => sum + item.qty, 0);
    const total = avlCart.reduce((sum, item) => sum + (item.price * item.qty), 0);
    
    document.getElementById('avlCartCount').textContent = count;
    document.getElementById('avlCartTotalDisplay').textContent = avlFormatPrice(total);
    document.getElementById('avlGrandTotal').textContent = avlFormatPrice(total);
    
    const container = document.getElementById('avlCartItemsContainer');
    const footer = document.getElementById('avlCartFooter');
    
    if (avlCart.length === 0) {
        container.innerHTML = '<div class="avl-cart-empty">Your basket is empty. Select strains and quantities above.</div>';
        footer.style.display = 'none';
        document.getElementById('avlCartBar').classList.remove('active');
        return;
    }
    
    footer.style.display = 'block';
    document.getElementById('avlCartBar').classList.add('active');
    
    container.innerHTML = avlCart.map((item, i) => `
        <div class="avl-cart-item">
            <img src="${item.image}" alt="" onerror="this.style.display='none'">
            <div class="avl-cart-item-info">
                <div class="avl-cart-item-name">${item.name}</div>
                <div class="avl-cart-item-meta">${item.grams}g × ${item.qty}</div>
            </div>
            <div class="avl-cart-item-price">${avlFormatPrice(item.price * item.qty)}</div>
            <button class="avl-cart-item-remove" onclick="avlRemoveFromCart(${i})" aria-label="Remove item">×</button>
        </div>
    `).join('');
}

function avlGenerateOrderText() {
    let text = `🍄 *NEW ORDER — 247AVL Plug*%0A%0A`;
    avlCart.forEach(item => {
        text += `• ${item.name}%0A  ${item.grams}g × ${item.qty} = *${avlFormatPrice(item.price * item.qty)}*%0A%0A`;
    });
    text += `*Grand Total: ${avlFormatPrice(avlCart.reduce((s,i)=>s+(i.price*i.qty),0))}*%0A%0APlease reply with your shipping details to complete the order.`;
    return text;
}

