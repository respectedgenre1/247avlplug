    let selectHtml = '<select class="avl-qty-select" onchange="avlUpdatePrice(this,\''+p.id+'\')">';
    avlQtyOptions.forEach((q,i) => {
        const price = avlCalculatePrice(p.basePrice, q.g, q.discount);
        selectHtml += `<option value="${q.g}" data-discount="${q.discount}" data-price="${price}" ${i===0?'selected':''}>${q.label} — ${avlFormatPrice(price)}</option>`;
    });
    selectHtml += '</select>';
    
    const potencyClass = p.potency === 'Beginner' ? 'avl-potency-beginner' : p.potency === 'Intermediate' ? 'avl-potency-intermediate' : 'avl-potency-advanced';
    
    card.innerHTML = `
        <div class="avl-product-image-wrap">
